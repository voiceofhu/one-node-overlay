{
  "name": "overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/logs/dev.log vite --mode prod --host 127.0.0.1 --port 27527",
    "build": "tsc -b && WRANGLER_LOG_PATH=.wrangler/logs/build.log vite build --mode prod",
    "preview": "pnpm build && WRANGLER_LOG_PATH=.wrangler/logs/preview.log vite preview --mode prod --host 127.0.0.1 --port 27527",
    "typecheck": "tsc -b",
    "lint": "oxlint src worker tests --deny-warnings",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/view": "6.43.10",
    "@uiw/codemirror-theme-github": "4.25.11",
    "@uiw/react-codemirror": "4.25.11",
    "lucide-react": "^1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260901.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.2",
    "typescript": "7.0.2",
    "vite": "^8.2.0",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
